{
  "name": "zapret-gui",
  "version": "1.1.0",
  "description": "GUI для zapret-discord-youtube (winws.exe): стратегии, служба, автозапуск, обновления — всё внутри приложения",
  "main": "main.js",
  "author": "you",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.zapret.gui",
    "productName": "Zapret GUI",
    "asar": true,
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "strategies.json",
      "renderer/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/zapret",
        "to": "zapret"
      },
      {
        "from": "vendor/tg-ws-proxy/bin",
        "to": "tg-ws-proxy/bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "ZapretGUI-portable.exe"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "electron-winstaller@5.4.0": true
  }
}
